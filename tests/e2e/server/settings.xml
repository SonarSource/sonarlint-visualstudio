<!-- Maven settings for the Orchestrator launcher. Credentials are read from the environment at build time. -->
<settings>
  <mirrors>
    <mirror>
      <id>repox</id>
      <mirrorOf>*</mirrorOf>
      <url>https://repox.jfrog.io/repox/sonarsource</url>
    </mirror>
  </mirrors>
  <servers>
    <server>
      <id>repox</id>
      <username>${env.ARTIFACTORY_USER}</username>
      <password>${env.ARTIFACTORY_PASSWORD}</password>
    </server>
  </servers>
</settings>
