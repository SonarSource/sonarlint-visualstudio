<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net48</TargetFramework>
    <IsTestProject>true</IsTestProject>
    <RequiresSigning>false</RequiresSigning>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <GenerateBindingRedirectsOutputType>true</GenerateBindingRedirectsOutputType>
    <VisualStudioInteropPath Condition="'$(VisualStudioInteropPath)' == ''">$(VisualStudioInstallPath)\Common7\IDE\PublicAssemblies\Microsoft.VisualStudio.Interop.dll</VisualStudioInteropPath>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="MSTest" Version="4.4.1" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.3" />
    <PackageReference Include="Microsoft.Alm.Authentication" Version="4.0.0.1" />
    <Reference Include="System.Net.Http" />
    <Reference Include="Microsoft.VisualStudio.Interop" HintPath="$(VisualStudioInteropPath)" Condition="Exists('$(VisualStudioInteropPath)')" />
    <Reference Include="EnvDTE" HintPath="$(VisualStudioInstallPath)\Common7\IDE\PublicAssemblies\envdte.dll" Condition="!Exists('$(VisualStudioInteropPath)')" />
    <Reference Include="EnvDTE80" HintPath="$(VisualStudioInstallPath)\Common7\IDE\PublicAssemblies\envdte80.dll" Condition="!Exists('$(VisualStudioInteropPath)')" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.IO.Compression.FileSystem" />
    <Compile Remove="Fixture/**/*.cs" />
    <None Include="Fixture/**/*" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>
  <Target Name="CheckVisualStudioInterop" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(VisualStudioInteropPath)') and (!Exists('$(VisualStudioInstallPath)\Common7\IDE\PublicAssemblies\envdte.dll') or !Exists('$(VisualStudioInstallPath)\Common7\IDE\PublicAssemblies\envdte80.dll'))" Text="Set VisualStudioInstallPath to the full Visual Studio installation." />
  </Target>
</Project>
