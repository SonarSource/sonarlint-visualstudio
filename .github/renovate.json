{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>SonarSource/renovate-config:ide-xp-team"
  ],
  "packageRules": [
    {
      "description": "Regenerate NuGet lockfiles after dependency updates",
      "matchManagers": [
        "nuget"
      ],
      "postUpgradeTasks": {
        "commands": [
          "dotnet restore SonarQube.VisualStudio.sln"
        ],
        "fileFilters": [
          "**/packages.lock.json"
        ],
        "executionMode": "branch"
      }
    },
    {
      "description": "Keep Roslyn, and the VS packages that pin it, at the version shipped with the earliest supported Visual Studio version",
      "matchManagers": [
        "nuget"
      ],
      "matchPackageNames": [
        "Microsoft.CodeAnalysis.Common",
        "Microsoft.CodeAnalysis.CSharp",
        "Microsoft.CodeAnalysis.CSharp.Workspaces",
        "Microsoft.CodeAnalysis.VisualBasic",
        "Microsoft.CodeAnalysis.Workspaces.Common",
        "Microsoft.VisualStudio.LanguageServices"
      ],
      "enabled": false
    },
    {
      "description": "FluentAssertions 8+ is under a commercial license (Xceed); stay on the Apache-2.0 licensed 7.x line",
      "matchManagers": [
        "nuget"
      ],
      "matchPackageNames": [
        "FluentAssertions"
      ],
      "allowedVersions": "<8"
    }
  ]
}
